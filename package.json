{
  "name": "kgreconcile",
  "version": "0.1.0",
  "description": "Reconciliation of entity labels to IRIs in a knowledge graph described in SHACL, as a library and a command line",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kgreconcile": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "cli": "ts-node src/cli.ts",
    "clean": "rm -rf dist",
    "build": "tsc",
    "prepack": "npm run build"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "js-yaml": "^4.1.0",
    "lunr": "^2.3.9",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "rdf-shacl-commons": "0.3.5"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/lunr": "^2.3.7",
    "@types/node": "^18.17.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
